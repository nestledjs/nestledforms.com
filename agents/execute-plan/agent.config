{
  "name": "Coder (from plan)",
  "context": "coderepos",
  "description": "Fires the task description as a claude --remote prompt piped to FlightDesk. No local session \u2014 TaskOS runs the command directly.",
  "command": "cd \"$([ -d \"$HOME/workspaces/nestledforms.com\" ] && printf %s \"$HOME/workspaces/nestledforms.com\" || printf %s \"$HOME/IdeaProjects/nestledforms.com\")\" && flightdesk register --project cd39bde3-16f7-4752-b55c-b49db44a25f5 --title '{title}' --prompt '{description}'",
  "output_rules": [
    {
      "pattern": "Task ID: ([a-f0-9-]{36})",
      "action": "add_link",
      "url": "https://flightdesk.dev/app/tasks/{1}"
    }
  ],
  "project": "nestledforms.com",
  "coding": true
}
